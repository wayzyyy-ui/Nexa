{
  "appId": "ru.nexalink.app",
  "appName": "NEXA",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#01090F"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#01090F",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "CapacitorUpdater": {
      "autoUpdate": "off",
      "appReadyTimeout": 15000,
      "responseTimeout": 20,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true,
      "updateUrl": "",
      "channelUrl": "",
      "statsUrl": "",
      "keepUrlPathAfterReload": false,
      "allowManualBundleError": true
    }
  }
}
