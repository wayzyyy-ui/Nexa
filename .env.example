# Скопируйте этот файл в .env.local и впишите значения из Supabase
# (Project Settings → API). Сам .env.local в git не попадает.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Яндекс Карты (JS API v3) — карта «Где устройство?». Ключ из кабинета разработчика Яндекса,
# с ограничением по HTTP Referer (см. CLAUDE.md). На Vercel — та же переменная в Environment Variables
VITE_YANDEX_MAPS_KEY=
# Яндекс — поиск (название города по координатам для погоды). Отдельный ключ «API поиска / геокодер»
# из того же кабинета, тоже с ограничением по HTTP Referer. Нет ключа — название берётся у запасных сервисов
VITE_YANDEX_SEARCH_KEY=

# Проверка «не робот» на входе по почте (hCaptcha): публичный ключ сайта (sitekey).
# Секретный ключ hCaptcha — только в Supabase (Auth → Bot and Abuse Protection), сюда не писать.
# Пусто — проверки нет. Для локальной проверки — тестовый ключ 10000000-ffff-ffff-ffff-000000000001
VITE_HCAPTCHA_SITEKEY=

# Самый большой файл в «Файлах», МБ (по умолчанию 50 — потолок бесплатного тарифа Supabase).
# Больше — только на платном тарифе и вместе с лимитом корзины (file_size_limit в supabase/files-storage.sql)
VITE_FILE_MAX_MB=

# Gismeteo (погода) — токен только для сервера api/weather.js (на Vercel — Environment Variables).
# Не начинается с VITE_, поэтому в сайт и приложение не попадает
GISMETEO_TOKEN=
