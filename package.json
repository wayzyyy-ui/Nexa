{
  "name": "nexa",
  "private": true,
  "version": "0.17.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "mini:train": "node scripts/mini/train.mjs",
    "mini:review": "node scripts/mini/review.mjs",
    "mini:merge": "node scripts/mini/merge.mjs",
    "preview": "vite preview",
    "build:android": "vite build --mode android && node -e \"const f=require('fs');f.rmSync('dist/nexa.apk',{force:true});f.rmSync('dist/ota',{recursive:true,force:true});f.rmSync('dist/nexa-setup.exe',{force:true});f.rmSync('dist/desktop',{recursive:true,force:true})\" && cap sync android",
    "open:android": "cap open android",
    "release:android": "node scripts/release-android.mjs",
    "release:web": "node scripts/release-web.mjs",
    "copy:apk": "node scripts/copy-apk.mjs",
    "installer:art": "node scripts/installer-art.mjs",
    "build:desktop": "node scripts/installer-art.mjs --bmp && vite build --mode desktop --outDir dist-desktop --emptyOutDir && node -e \"const f=require('fs');for(const x of ['nexa.apk','nexa-setup.exe','version.json','ota','desktop','sitemap.xml'])f.rmSync('dist-desktop/'+x,{recursive:true,force:true})\"",
    "release:desktop": "node scripts/release-desktop.mjs",
    "dev:desktop": "tauri build --debug --no-bundle --config desktop/src-tauri/tauri.conf.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-updater": "8.52.1",
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tauri-apps/api": "2.12.1",
    "heic2any": "0.0.4",
    "lenis": "^1.3.26",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
