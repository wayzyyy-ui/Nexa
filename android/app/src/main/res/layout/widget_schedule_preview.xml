<?xml version="1.0" encoding="utf-8"?>
<!-- Превью «Расписания» в списке виджетов (Android 12+): пример, не настоящие данные -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Шапка: «Сегодня», дата и сколько ещё дел -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="22dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/widget_schedule_title"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/schedule_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Понедельник, 12 октября"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/schedule_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widget_muted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Тонкая линия 1dp -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@color/widget_border" />

        <LinearLayout
            android:id="@+id/schedule_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/schedule_time1"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:text="09:30"
                android:textColor="@color/widget_accent"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/schedule_title1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Лекция по проектированию"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/schedule_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/schedule_time2"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:text="11:00"
                android:textColor="@color/widget_accent"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/schedule_title2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Встреча с куратором"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/schedule_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/schedule_time3"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:text="14:30"
                android:textColor="@color/widget_accent"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/schedule_title3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Работа над дипломом"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/schedule_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_schedule_free"
            android:textColor="@color/widget_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Уголок-складка NEXA — внутри полей: лаунчеры Android 12+ скругляют углы виджета сами -->
    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_fold" />
</FrameLayout>
